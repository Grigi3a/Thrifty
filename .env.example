# Copiez ce fichier en .env (ou saisissez ces valeurs dans le tableau de bord de votre hébergeur).
PORT=3000
# Dossier PERSISTANT : base de données + photos. Doit être un disque/volume qui survit aux redéploiements.
DATA_DIR=./data
# Compte administrateur créé au premier démarrage (si aucun admin n'existe)
ADMIN_EMAIL=vous@exemple.ma
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long
# Adresse publique du site (liens des e-mails, partage WhatsApp, sitemap)
BASE_URL=https://www.votre-domaine.ma
# 1 si le site est derrière un proxy/HTTPS (Render, Nginx, Caddy, Cloudflare…)
TRUST_PROXY=1
COOKIE_SECURE=1
# Envoi d'e-mails (réinitialisation de mot de passe). Ex. smtp://utilisateur:motdepasse@smtp.exemple.com:587
SMTP_URL=
MAIL_FROM=Thrifty <no-reply@votre-domaine.ma>
# Tarifs par défaut (modifiables ensuite dans Administration > Réglages)
DEFAULT_COMMISSION_RATE=0.10
DEFAULT_SHIPPING=25
# Mentions légales (affichées sur les pages légales)
COMPANY_NAME=
COMPANY_LEGAL_FORM=
COMPANY_ADDRESS=
COMPANY_ICE=
COMPANY_RC=
CONTACT_EMAIL=
CONTACT_PHONE=
HOSTING_PROVIDER=
